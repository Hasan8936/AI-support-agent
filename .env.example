ANTHROPIC_API_KEY=replace-me
OPENAI_API_KEY=replace-me
JUDGE_PROVIDER=anthropic
BRAND=AmazonHelp

# Optional Smart Job Tracker human-escalation notifications.
# If SMTP_HOST or SUPPORT_ESCALATION_EMAIL is unset, the API returns a safe
# fallback and logs the event without attempting to send email.
SUPPORT_ESCALATION_EMAIL=support@example.com
SUPPORT_ESCALATION_CONTACT=Support team
SUPPORT_ESCALATION_FALLBACK_MESSAGE=This message needs a human review. Your request has been recorded for the support team, and someone will follow up through the configured support channel.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=support@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT=10
